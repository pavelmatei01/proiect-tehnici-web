<script src="/resurse/js/tema.js"></script>

<header>
  <h1>
    <a href="/#acasa" style="color: inherit; text-decoration: none;">
        <i class="fa-solid fa-gear"></i>
        TrainMag
    </a>
  </h1>
  
  <a href="/#acasa">
      <img src="/resurse/imagini/logo/logotrainmag.png" alt="Sigla magazinului TrainMag" width="200">
  </a>

  <nav>
    <input type="checkbox" id="burger-toggle">
    <label for="burger-toggle" class="burger-icon">
        <i class="fa-solid fa-bars"></i>
    </label>
    
    <ul id="meniu-principal">
      <li>
        <a href="/#acasa" title="Acasă"><i class="fa-solid fa-home"></i><span>Acasă</span></a>
        <ul class="submeniu">
          <li><a href="/#welcome" title="Despre Noi">Despre Noi</a></li>
          <li><a href="/#promotii" title="Oferte Speciale">Oferte Speciale</a></li>
          <li><a href="/#orar" title="Evenimente">Evenimente</a></li>
          <li><a href="/#specificatii" title="Specificații Tehnice">Specificații Tehnice</a></li>
          <li><a href="/#index-intrebari" title="Întrebări Frecvente (FAQ)">Întrebări Frecvente (FAQ)</a></li>
        </ul>
      </li>
      
      <li>
        <a href="/produse" title="Catalog Produse"><i class="fa-solid fa-box-open"></i> Produse</a>
        <ul class="submeniu">
            <li><a href="/produse" title="Toate produsele">Toate</a></li>
            <% if (locals.optiuniMeniu) { %>
                <% for (let opt of locals.optiuniMeniu) { %>
                    <li>
                        <a href="/produse?categorie=<%- opt %>" title="Categoria <%- opt %>">
                            <%- opt.charAt(0).toUpperCase() + opt.slice(1).replace(/_/g, ' ') %>
                        </a>
                    </li>
                <% } %>
            <% } %>
            <li><a href="/seturi" title="Seturi de produse"><i class="fa-solid fa-layer-group"></i> Seturi</a></li>
        </ul>
      </li>
      
      <li>
        <a href="/contact.html" title="Contact și Locație"><i class="fa-solid fa-address-card"></i> Contact și Locație</a>
      </li>

      <!-- Butonul pentru schimbarea temei Light/Dark -->
      <li class="d-flex align-items-center ms-lg-3 mt-2 mt-md-0">
          <div class="form-check form-switch">
              <input class="form-check-input" type="checkbox" role="switch" id="schimba_tema" style="width: 3rem; height: 1.5rem; cursor: pointer;">
              <label class="form-check-label ms-2 mt-1" for="schimba_tema" style="cursor: pointer;">
                  <i id="icon_tema" class="fa-solid fa-sun fs-5"></i>
              </label>
          </div>
      </li>
    </ul>
  </nav>
</header>